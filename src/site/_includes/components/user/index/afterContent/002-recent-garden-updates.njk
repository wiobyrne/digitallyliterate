<section class="garden-index notebook-section" aria-labelledby="notebook-heading">
  <p class="garden-index__eyebrow">From the notebook</p>
  <h2 id="notebook-heading">Recently updated Evergreens</h2>
  <p class="notebook-intro">The Garden is a connected notebook of ideas that recur across the issues.</p>
  {% if collections.recentEvergreens | length %}
  <ul class="notebook-list">
    {% for note in collections.recentEvergreens %}
    <li>
      <a href="{{ note.url }}">{{ note.data.title }}</a>
      {% set description = note.data["dg-note-properties"].description or note.data.metatags.description %}
      {% if description %}<p>{{ description }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>Notebook pages will appear here as they are ready to share.</p>
  {% endif %}
  <p class="notebook-guide-link"><a href="/start-here/">What’s the Garden? Read the guide <span aria-hidden="true">→</span></a></p>
</section>
