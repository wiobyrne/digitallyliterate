{% if collections.recentGardenUpdates | length %}
<section class="garden-index" aria-labelledby="recent-garden-updates">
<p class="garden-index__eyebrow">Growing now</p>
<h2 id="recent-garden-updates">Recent updates to the garden</h2>
<ol class="recent-list">
{%- for note in collections.recentGardenUpdates -%}
  <li>
    <span class="recent-list__number">{{ note.data.gardenType }}</span>
    <a href="{{ note.url }}">{% if note.data.title %}{{ note.data.title }}{% else %}{{ note.fileSlug }}{% endif %}</a>
  </li>
{%- endfor -%}
</ol>
</section>
{% endif %}
