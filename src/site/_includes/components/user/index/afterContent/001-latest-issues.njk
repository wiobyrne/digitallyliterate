{% set latestIssues = collections.latestNewsletter %}
{% if latestIssues | length %}
{% set featuredIssue = latestIssues[0] %}
<section class="garden-index home-issues" aria-labelledby="latest-issue-heading">
  <div class="home-section-head">
    <div class="home-section-headcopy">
      <p class="garden-index__eyebrow">Newsletter</p>
      <h2 id="latest-issue-heading">Latest issue</h2>
    </div>
    <a class="home-section-more" href="/newsletter/">All issues <span aria-hidden="true">→</span></a>
  </div>

  <article class="latest-issue-feature">
    <p class="latest-issue-date">No. {{ featuredIssue.data.issueNumber }} <span aria-hidden="true">·</span> <time datetime="{{ featuredIssue.data.issueDateISO }}">{{ featuredIssue.data.issueDate }}</time></p>
    <h3><a href="{{ featuredIssue.url }}">{{ featuredIssue.data.title }}</a></h3>
    {% if featuredIssue.data.issueDescription %}<p class="latest-issue-description">{{ featuredIssue.data.issueDescription }}</p>{% endif %}
    {% if featuredIssue.data.linkedEvergreens | length %}
    <p class="issue-list-notebook">In the notebook:
      {% for evergreen in featuredIssue.data.linkedEvergreens %}<a href="{{ evergreen.url }}">{{ evergreen.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
    </p>
    {% endif %}
  </article>

  {% if latestIssues | length > 2 %}
  <h3 class="home-subsection-heading">Recent issues</h3>
  <ol class="issue-list">
    {% for note in latestIssues %}
      {% if not loop.first %}
      <li>
        <p class="issue-list-meta">No. {{ note.data.issueNumber }} <span aria-hidden="true">·</span> <time datetime="{{ note.data.issueDateISO }}">{{ note.data.issueDate }}</time></p>
        <a class="issue-list-title" href="{{ note.url }}">{{ note.data.title }}</a>
        {% if note.data.issueDescription %}<p class="issue-list-description">{{ note.data.issueDescription }}</p>{% endif %}
        {% if note.data.linkedEvergreens | length %}
        <p class="issue-list-notebook">In the notebook:
          {% for evergreen in note.data.linkedEvergreens %}<a href="{{ evergreen.url }}">{{ evergreen.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
        {% endif %}
      </li>
      {% endif %}
    {% endfor %}
  </ol>
  {% endif %}
  <p class="issue-subscribe">New issues every Wednesday. <a href="/subscribe/">Subscribe <span aria-hidden="true">→</span></a></p>
</section>
{% endif %}
