{% if latestEssay %}
<section class="garden-index elsewhere-section" aria-labelledby="elsewhere-heading">
  <div class="home-section-head">
    <div class="home-section-headcopy">
      <p class="garden-index__eyebrow">Elsewhere</p>
      <h2 id="elsewhere-heading">Latest from wiobyrne.com</h2>
    </div>
    <a class="home-section-more" href="https://wiobyrne.com/writing/">More at wiobyrne.com <span aria-hidden="true">↗</span></a>
  </div>
  <article class="elsewhere-feature">
    <p class="elsewhere-date"><time datetime="{{ latestEssay.dateISO }}">{{ latestEssay.date }}</time></p>
    <h3><a href="{{ latestEssay.url }}">{{ latestEssay.title }}</a></h3>
    <p>{{ latestEssay.description }}</p>
  </article>
</section>
{% endif %}
