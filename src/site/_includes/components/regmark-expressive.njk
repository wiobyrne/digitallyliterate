{# Large-format Apparatus mark. Use only at 48px+ in heroes, social cards,
   covers, diagrams, or rare campaign moments. All system chrome stays clean.
   Set expressiveRegmarkId when more than one appears on a page. #}
{% set markSize = expressiveRegmarkSize or 64 %}
{% set markId = expressiveRegmarkId or "dl-regmark-ink" %}
<span class="regmark-expressive" style="--regmark-expressive-size: {{ markSize }}px" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none">
    <defs>
      <filter id="{{ markId }}" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.72" numOctaves="2" seed="14" result="noise"/>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.34" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs>
    <g filter="url(#{{ markId }})">
      <circle cx="12" cy="12" r="7.2"/>
      <line x1="12" y1="1.5" x2="12" y2="22.5"/>
      <line x1="1.5" y1="12" x2="22.5" y2="12"/>
      <circle class="regmark-expressive__dot" cx="12" cy="12" r="0.75"/>
    </g>
  </svg>
</span>
